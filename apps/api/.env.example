NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://warp:change-me@127.0.0.1:5432/warp?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax
MAIL_PROVIDER=smtp
# Railway Free/Trial/Hobby: set MAIL_PROVIDER=resend and configure this key.
# RESEND_API_KEY=your-private-api-key
# Production: configure Resend or SMTP plus HTTPS. See docs/DEPLOY_RAILWAY.md.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Warp <noreply@example.com>
# Optional, development only: write mail to a directory instead of SMTP.
# DEV_MAIL_DIR=../../.local/mail
